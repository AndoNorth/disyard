<mxfile host="drawio">
  <diagram id="pool-worker" name="pool worker">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Pool worker&lt;/b&gt;: one long-lived single-slot pod per pool serves run_task on its unversioned queue, one child process at a time" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="temporal" value="&lt;b&gt;Temporal&lt;/b&gt; (#6)&lt;br&gt;JobWorkflow starts &lt;i&gt;run_task&lt;/i&gt; on queue&lt;br&gt;&lt;i&gt;dsy-compile&lt;/i&gt;, &lt;i&gt;dsy-simulate&lt;/i&gt; or &lt;i&gt;dsy-aggregate&lt;/i&gt;,&lt;br&gt;with an optional run prefix in front and never a build id&lt;br&gt;&lt;br&gt;one attempt per activity, the workflow owns every retry&lt;br&gt;&lt;br&gt;start-to-close and heartbeat timeouts from pools.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="270" height="230" as="geometry"/></mxCell>
        <mxCell id="pod" value="&amp;lt;pool&amp;gt;-worker pod in dsy-workers: python -m dsy_worker --pool &amp;lt;pool&amp;gt;&lt;br&gt;&lt;span style=&quot;font-weight: normal&quot;&gt;requests = limits = the slot, one task at a time (max_concurrent_activities 1), no database&lt;/span&gt;" style="swimlane;startSize=44;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="670" height="595" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 Dispatch&lt;/b&gt; on task_type to pools.&amp;lt;pool&amp;gt;.run(task, context)&lt;br&gt;read_request reads the worker stage's fields, never cpu_cores or memory_mib" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="56" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 Stage&lt;/b&gt; the inputs from the store into emptied scratch&lt;br&gt;source bundle, component or index, and input.json from the params" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="120" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 Warm-up&lt;/b&gt;, simulate only, on the first run of a component on the pod&lt;br&gt;dsy_runtime warm_up in its own process, then the guest runs warm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="184" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 Run the child in its own process group&lt;/b&gt; (runner.Child)&lt;br&gt;wasmtime capped at the slot less the worker reserve, until the deadline,&lt;br&gt;or limits fetch then dsy_compile build, or dsy_aggregate run&lt;br&gt;output read live into a 64 KiB tail and the HEARTBEAT parser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="248" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 Classify&lt;/b&gt; the exit code, the signal and memory.events oom_kill&lt;br&gt;into one row of failure-classes.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="342" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6 Collect&lt;/b&gt; the declared outputs, attempt-scoped&lt;br&gt;component.wasm and build-info.json, results.xml, or summary.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="406" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7 Upload the log tail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="470" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;8 Return&lt;/b&gt; a TaskResult of references only, or raise&lt;br&gt;ApplicationError(type = the class, FailureDetails with the tail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="250" y="518" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="beat" value="&lt;b&gt;Heartbeat loop&lt;/b&gt;, its own asyncio task, every min(10 s, heartbeat timeout / 3), from stage to upload, whatever the child prints&lt;br&gt;HeartbeatDetails: the latest progress line or nulls, checkpoint null, started_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="20" y="126" width="210" height="150" as="geometry"/></mxCell>
        <mxCell id="cancel" value="&lt;b&gt;Cancel&lt;/b&gt; on a heartbeat reply: stop the group (SIGTERM, 5 s, SIGKILL) and re-raise, so the attempt is withdrawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="20" y="290" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="drain" value="&lt;b&gt;SIGTERM drain&lt;/b&gt;: stop polling, give the task 30 s, then stop the group and fail as worker_shutdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="20" y="384" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="scratch" value="&lt;b&gt;/var/dsy&lt;/b&gt;, a disk emptyDir: task scratch, TMPDIR, HOME, the uv and wasmtime caches and the ready file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="pod"><mxGeometry x="20" y="478" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="store" value="&lt;b&gt;Object store&lt;/b&gt; (#3, #12)&lt;br&gt;Secret &amp;lt;pool&amp;gt;-worker-store: the pool's one identity&lt;br&gt;reads dsy-sources or dsy-components&lt;br&gt;writes the attempt's outputs and its log tail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="mirror" value="&lt;b&gt;Package mirror&lt;/b&gt;, compile only&lt;br&gt;the limits fetch reaches it, the offline build does not" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="313.0" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="defer" value="&lt;b&gt;Not in this pass&lt;/b&gt;&lt;br&gt;checkpoints, operator_interrupt and resume (#18)&lt;br&gt;metrics and JSON logs (#13)&lt;br&gt;OOM classes under the cgroup v2 group kill (#15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="560" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="TaskInput" style="endArrow=classic;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.309;entryX=0;entryY=0.5;" edge="1" parent="1" source="temporal" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb" value="heartbeats,&lt;br&gt;cancel in reply" style="endArrow=classic;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.830;" edge="1" parent="1" source="beat" target="temporal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="result or failure" style="endArrow=classic;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="s8" target="temporal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="690"/><mxPoint x="155" y="690"/></Array></mxGeometry></mxCell>
        <mxCell id="es" value="get" style="endArrow=classic;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.550;entryX=1;entryY=0.5;" edge="1" parent="1" source="store" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="em" value="fetch" style="endArrow=classic;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="mirror"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec" value="put" style="endArrow=classic;html=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="s6" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="491.0"/><mxPoint x="1420" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="fs1" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fs2" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fs3" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fs4" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fs5" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fs6" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fs7" style="endArrow=classic;html=1;" edge="1" parent="pod" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
