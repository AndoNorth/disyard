yDx=0;entryDy=0;" edge="1" parent="1" source="smoke" target="graf"><mxGeometry relative="1" as="geometry" x="0.3"><Array as="points"><mxPoint x="760" y="515"/><mxPoint x="760" y="320"/></Array></mxGeometry></mxCell><mxCell id="e-link" value="job_id and temporalWorkflowID&lt;br&gt;link to job-&amp;lt;job id&amp;gt;" style="endArrow=block;endFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="graf" target="tui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;fontFamily=IBM Plex Mono;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="548" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg-view" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="552" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg-view-t" value="viewing surface on 127.0.0.1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="103" y="548" width="180" height="18" as="geometry"/></mxCell><mxCell id="lg-hub" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="552" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg-hub-t" value="the one collector" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="305" y="548" width="120" height="18" as="geometry"/></mxCell><mxCell id="lg-sw" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#f5b84a;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="435" y="552" width="18" height="10" as="geometry"/></mxCell><mxCell id="lg-sw-t" value="the observability switch: everything inside runs only with DSY_OBS=on" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="460" y="548" width="420" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Grafana is the window for fleet health, queue depths, alerts and the smoke results. The per-job drill-down is Explore by job_id in Loki: a line&#x27;s trace_id opens its trace in Tempo, and its job_id opens the job&#x27;s workflow page in the Temporal UI, as a span&#x27;s temporalWorkflowID does. With the UI off, temporal workflow show through a forward of the frontend gives the same timeline. Temporal keeps a closed workflow&#x27;s history 24 hours." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="574" width="960" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
