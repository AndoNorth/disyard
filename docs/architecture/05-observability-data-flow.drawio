<mxfile host="app.diagrams.net"><diagram id="d5" name="Observability data flow"><mxGraphModel dx="1000" dy="650" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="650" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Observability data flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;fontColor=#c9cbd0;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="960" height="32" as="geometry"/></mxCell><mxCell id="switch" value="" style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#f5b84a;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="680" height="430" as="geometry"/></mxCell><mxCell id="switch-t" value="Behind the switch, chosen at cluster creation: &lt;b&gt;DSY_OBS=on just up&lt;/b&gt;. The obs node and namespace dsy-obs, and the Temporal UI on the infra node" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;fontColor=#f5b84a;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="310" y="64" width="660" height="18" as="geometry"/></mxCell><mxCell id="svc" value="Python services&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;dispatch, admission&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;workflow, placement&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;compile, simulate and&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;aggregate workers&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;metrics port named metrics&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="220" height="170" as="geometry"/></mxCell><mxCell id="third" value="Scraped third parties&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;Temporal server :9090&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;RabbitMQ :15692, job rabbitmq-detailed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;SeaweedFS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;kubelet and cAdvisor :10250&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="220" height="110" as="geometry"/></mxCell><mxCell id="smoke" value="Smoke gate on the host&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;just smoke, after its count line&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="220" height="60" as="geometry"/></mxCell><mxCell id="coll" value="Collector&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;one Deployment&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;OTLP logs and traces&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;Kubernetes event watch&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontF