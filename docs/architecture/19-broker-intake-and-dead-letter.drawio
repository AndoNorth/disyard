<mxfile host="drawio"><diagram id="broker-intake-and-dead-letter" name="Broker intake and dead letter"><mxGraphModel dx="960" dy="690" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="690" background="#0a1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Broker intake and dead letter" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="600" height="32" as="geometry" /></mxCell><mxCell id="obs" value="Observability&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;queue counts and consumers on :15692,&lt;br&gt;client counters, three alert rules&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="230" height="62" as="geometry" /></mxCell><mxCell id="dis" value="Dispatch&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;publishes each accepted event&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="150" height="56" as="geometry" /></mxCell><mxCell id="out" value="outcome: ACCEPTED, REJECTED when the queue is full, UNROUTABLE when no queue has the key, or a timeout under a memory alarm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="190" height="70" as="geometry" /></mxCell><mxCell id="ex" value="wdf.intake&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;direct exchange&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="140" height="56" as="geometry" /></mxCell><mxCell id="iq" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="440" y="96" width="250" height="164" as="geometry" /></mxCell><mxCell id="iql" value="INTAKE QUEUES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="452" y="104" width="226" height="18" as="geometry" /></mxCell><mxCell id="iq0" value="intake.&amp;lt;tenant&amp;gt;.&amp;lt;class&amp;gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;quorum, one per tenant and class&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="452" y="128" width="226" height="44" as="geometry" /></mxCell><mxCell id="iq1" value="policy wdf-intake&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;delivery limit 5, max-length 1,000 then reject,&lt;br&gt;a counted retry waits 1 s per count up to 30 s,&lt;br&gt;dead letters to wdf.dlx, at least once&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="452" y="180" width="226" height="70" as="geometry" /></mxCell><mxCell id="adm" value="Admission&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;pulls with credit, one per credit&lt;br&gt;ack: done&lt;br&gt;retry: a fault of the message&lt;br&gt;release: a cause outside it&lt;br&gt;dead_letter: a reason and a detail&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="170" height="110" as="geometry" /></mxCell><mxCell id="dlx" value="wdf.dlx&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;fanout exchange&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="500" y="320" width="130" height="56" as="geometry" /></mxCell><mxCell id="dq" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#1a1a33;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="380" height="140" as="geometry" /></mxCell><mxCell id="dql" value="DEAD-LETTER QUEUE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="308" width="356" height="18" as="geometry" /></mxCell><mxCell id="dq0" value="intake.dlq&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;quorum, policy wdf-dlq: no delivery limit, no TTL,&lt;br&gt;kept until replayed or purged&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#212240;strokeColor=#fb7085;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="42" y="332" width="356" height="44" as="geometry" /></mxCell><mxCell id="dq1" value="reason: x-opt-wdf-reason, else x-last-death-reason&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;MALFORMED, UNSUPPORTED_VERSION, ADMISSION_FAILED, delivery_limit&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="42" y="384" width="356" height="46" as="geometry" /></mxCell><mxCell id="tool" value="Operator: dead-letter tool&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;list, show, purge, and replay: republish the bare event,&lt;br&gt;upgraded, to its first-death queue&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="380" height="62" as="geometry" /></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dis" target="ex"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="iq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.37;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="iq" target="adm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#fb7085;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="iq" target="dlx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="290" /><mxPoint x="552" y="290" /></Array></mxGeometry></mxCell><mxCell id="e5" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#fb7085;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="dlx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="348" /></Array></mxGeometry></mxCell><mxCell id="e6" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#fb7085;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.343;entryDx=0;entryDy=0;" edge="1" parent="1" source="dlx" target="dq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#fb7085;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dq" target="tool"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tool" target="ex"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="511" /><mxPoint x="425" y="200" /><mxPoint x="310" y="200" /></Array></mxGeometry></mxCell><mxCell id="e9" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iq" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="51" /></Array></mxGeometry></mxCell><mxCell id="l1" value="by routing&lt;br&gt;key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="386" y="146" width="52" height="28" as="geometry" /></mxCell><mxCell id="l2" value="pull,&lt;br&gt;drain" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="162" width="50" height="28" as="geometry" /></mxCell><mxCell id="l3" value="sixth failed delivery,&lt;br&gt;or a lost last one" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="572" y="272" width="130" height="28" as="geometry" /></mxCell><mxCell id="l4" value="dead_letter" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="80" height="14" as="geometry" /></mxCell><mxCell id="l5" value="replay" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="452" width="50" height="14" as="geometry" /></mxCell><mxCell id="lgh" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="60" height="18" as="geometry" /></mxCell><mxCell id="lg0s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="584" width="10" height="10" as="geometry" /></mxCell><mxCell id="lg0t" value="broker" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="580" width="50" height="18" as="geometry" /></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#fb7085;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="167" y="584" width="10" height="10" as="geometry" /></mxCell><mxCell id="lg1t" value="failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="182" y="580" width="80" height="18" as="geometry" /></mxCell><mxCell id="lg2s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#252b39;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="584" width="10" height="10" as="geometry" /></mxCell><mxCell id="lg2t" value="neighbour role" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="291" y="580" width="96" height="18" as="geometry" /></mxCell><mxCell id="lg3s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="401" y="584" width="10" height="10" as="geometry" /></mxCell><mxCell id="lg3t" value="planned" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="416" y="580" width="60" height="18" as="geometry" /></mxCell><mxCell id="cap" value="Dispatch publishes each accepted event to wdf.intake, which routes it by its routing key to the quorum queue of its tenant and priority class. Admission receives a message only for credit it grants and settles each one: a counted retry comes back after a delay and dead-letters after the fifth, a release counts nothing and returns to the head of the queue, and a held delivery lost with its connection counts as failed. Every dead letter lands in one queue with a reason that says how to recover it, and stays there until an operator replays or purges it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="910" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>