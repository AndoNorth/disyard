<mxfile host="drawio"><diagram id="dispatch-and-control" name="Dispatch and control"><mxGraphModel dx="1110" dy="870" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1110" pageHeight="870" background="#0a1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Dispatch and control" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#c9cbd0;fontSize=20;fontFamily=IBM Plex Sans;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="700" height="32" as="geometry" /></mxCell><mxCell id="sub" value="Submitter&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;a batch of jobs per call&lt;br&gt;as NDJSON, content&lt;br&gt;uploaded by hash&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="102" width="150" height="64" as="geometry" /></mxCell><mxCell id="op" value="Operator&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;cancel, terminate,&lt;br&gt;pause, resume, status&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="438" width="150" height="64" as="geometry" /></mxCell><mxCell id="svc" value="" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="450" height="650" as="geometry" /></mxCell><mxCell id="svcl" value="DISPATCH AND CONTROL SERVICE, ONE PROCESS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="222" y="78" width="426" height="18" as="geometry" /></mxCell><mxCell id="dl" value="dispatch-api listener&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;127.0.0.1:18081: uploads, batch submit, batch reads&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="222" y="104" width="426" height="60" as="geometry" /></mxCell><mxCell id="seq" value="Submit sequence, per chunk of entries&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;1. validate each entry, derive its job id from its key, fingerprint it&lt;br&gt;2. index the template&#x27;s content and link it to each job, commit&lt;br&gt;3. insert the job rows and one accepted event per row, commit&lt;br&gt;4. answer one line per entry: accepted, duplicate or rejected&lt;br&gt;5. publish each new row&#x27;s accepted event, and on ACCEPTED&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;set the receipt once and record that it was published&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="222" y="178" width="426" height="150" as="geometry" /></mxCell><mxCell id="rec" value="Reconciler&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;rows still accepted with no receipt after a grace period:&lt;br&gt;rebuild the accepted event byte for byte and publish it again&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="222" y="342" width="426" height="62" as="geometry" /></mxCell><mxCell id="cl" value="control-api listener&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;127.0.0.1:18080: control of a job or a batch, job status&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="222" y="440" width="426" height="60" as="geometry" /></mxCell><mxCell id="ct" value="Control table&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;under the row lock, decides from the status, whether a workflow exists&lt;br&gt;and the outstanding action: applied, requested, noop or refused,&lt;br&gt;with the row writes and events in one transaction.&lt;br&gt;A resume is only requested on the row, never signalled&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="222" y="514" width="426" height="86" as="geometry" /></mxCell><mxCell id="rt" value="Control retrier&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;sends each outstanding cancel, terminate or pause to its workflow&lt;br&gt;until the server accepts it, then marks it delivered.&lt;br&gt;Its resume finisher returns a row whose workflow is gone&lt;br&gt;to accepted, for admission to start again&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="222" y="614" width="426" height="90" as="geometry" /></mxCell><mxCell id="obj" value="Object store&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;source bundles, index objects,&lt;br&gt;batch manifests&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="104" width="170" height="60" as="geometry" /></mxCell><mxCell id="db" value="Job store&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;job rows: the unique key, status,&lt;br&gt;receipt, requested action,&lt;br&gt;control sequence and&lt;br&gt;pending patch&lt;br&gt;&lt;br&gt;events of each job&lt;br&gt;&lt;br&gt;content links of each job&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=top;spacingTop=14;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="290" width="170" height="414" as="geometry" /></mxCell><mxCell id="brk" value="Broker&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;an intake queue per tenant&lt;br&gt;and priority class&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="170" width="150" height="96" as="geometry" /></mxCell><mxCell id="adm" value="Admission&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;claims accepted rows and&lt;br&gt;starts their workflows,&lt;br&gt;sets a missing receipt,&lt;br&gt;and alone sends resume&lt;br&gt;with the pending patch&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="150" height="120" as="geometry" /></mxCell><mxCell id="wf" value="Workflow engine&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;one workflow per job,&lt;br&gt;signals and status query&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=18;verticalAlign=middle;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="600" width="150" height="80" as="geometry" /></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sub" target="dl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="op" target="cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dl" target="obj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.1467;exitDx=0;exitDy=0;entryX=0;entryY=0.3125;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="brk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.8933;exitDx=0;exitDy=0;entryX=0;entryY=0.0531;entryDx=0;entryDy=0;" edge="1" parent="1" source="seq" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.6935;exitDx=0;exitDy=0;entryX=0;entryY=0.2295;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" style="jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.2903;exitDx=0;exitDy=0;entryX=0;entryY=0.7812;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="brk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="360" /><mxPoint x="690" y="245" /></Array></mxGeometry></mxCell><mxCell id="e8" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6449;entryDx=0;entryDy=0;" edge="1" parent="1" source="ct" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.2889;exitDx=0;exitDy=0;entryX=0;entryY=0.8454;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="wf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="750" /><mxPoint x="1015" y="750" /></Array></mxGeometry></mxCell><mxCell id="e11" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="brk" target="adm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=1;exitY=0.2657;exitDx=0;exitDy=0;entryX=0;entryY=0.5833;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="adm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeWidth=1.6;strokeColor=#8c8f98;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="wf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l3" value="uploads,&lt;br&gt;manifests" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="663" y="96" width="56" height="28" as="geometry" /></mxCell><mxCell id="l4" value="accepted event" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="184" width="120" height="14" as="geometry" /></mxCell><mxCell id="l7" value="republish" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="229" width="140" height="14" as="geometry" /></mxCell><mxCell id="l12" value="claim,&lt;br&gt;receipt,&lt;br&gt;resume" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="896" y="352" width="44" height="42" as="geometry" /></mxCell><mxCell id="l13" value="start,&lt;br&gt;resume" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="1022" y="505" width="80" height="28" as="geometry" /></mxCell><mxCell id="l10" value="cancel, terminate, pause signals" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="700" y="732" width="260" height="14" as="geometry" /></mxCell><mxCell id="l11" value="intake" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="1022" y="284" width="70" height="28" as="geometry" /></mxCell><mxCell id="lgh" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="60" height="18" as="geometry" /></mxCell><mxCell id="lg0s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="784" width="10" height="10" as="geometry" /></mxCell><mxCell id="lg0t" value="part of this service" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="780" width="130" height="18" as="geometry" /></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#252b39;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="236" y="784" width="10" height="10" as="geometry" /></mxCell><mxCell id="lg1t" value="neighbour role" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="251" y="780" width="96" height="18" as="geometry" /></mxCell><mxCell id="cap" value="A submit call answers each entry once its row is committed and publishes after the answer, so the job store and not the broker bounds the answer, and the reconciler publishes whatever a call left unpublished. Control writes the request to the job row first: a job that never started is settled on the row alone, and for a started job the retrier delivers cancel, terminate and pause to its workflow while admission delivers resume. Every call is safe to repeat." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="806" width="1070" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
