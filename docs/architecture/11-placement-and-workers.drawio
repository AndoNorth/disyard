;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="200" height="18" as="geometry"/></mxCell><mxCell id="lp2" value="poll, heartbeat, cancel" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="530" width="200" height="18" as="geometry"/></mxCell><mxCell id="l6" value="any pool, reported as failure" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="614" width="160" height="18" as="geometry"/></mxCell><mxCell id="l7" value="retry or pause job" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="170" y="664" width="130" height="18" as="geometry"/></mxCell><mxCell id="l8" value="checkpoint write, planned" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="626" width="165" height="18" as="geometry"/></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg0s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="744" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg0t" value="Temporal and placement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="740" width="140" height="18" as="geometry"/></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="257" y="744" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg1t" value="durable state" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="272" y="740" width="80" height="18" as="geometry"/></mxCell><mxCell id="lg2s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#fb7085;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="366" y="744" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg2t" value="failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="381" y="740" width="76" height="18" as="geometry"/></mxCell><mxCell id="lg3s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#8c8f98;strokeWidth=1.5;dashed=1;dashPattern=3 2;" vertex="1" parent="1"><mxGeometry x="471" y="744" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg3t" value="planned or optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="486" y="740" width="116" height="18" as="geometry"/></mxCell><mxCell id="caption" value="Temporal owns the workflow and the task backlog. For each ready task the workflow worker calls place, a local activity whose answer is kept in the workflow history, so a replay never asks again. The placement service in wdf-control answers from the pool table with a pool task queue, a memory class and the activity timeouts, or with an unschedulable verdict, and never holds a backlog. Its read-only service account lists the pool nodes and pods on a slow cadence: a failed read keeps the last good snapshot, a placement never waits for it, and each answer is logged with the snapshot&#x27;s age and the ready workers of its pool. Each pool has its own unversioned task queue served by long-lived slot worker pods, one task per pod. An OOM shows in the pod&#x27;s memory.events, the cgroup v2 group kill ends the task, and the workflow sees a heartbeat timeout. Checkpoints written to object storage for resume are planned." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="920" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>