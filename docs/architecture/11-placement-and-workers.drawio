=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="555" y="400" width="360" height="92" as="geometry"/></mxCell><mxCell id="pool1l" value="SIMULATE POOL  wdf.dev/pool=simulate" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="567" y="408" width="336" height="18" as="geometry"/></mxCell><mxCell id="pod1" value="Slot worker pods&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;wasm guest, fresh instance per execution, one slot per pod; memory cap, CPU limit, timeout&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="570" y="426" width="330" height="56" as="geometry"/></mxCell><mxCell id="pool2" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="555" y="500" width="360" height="92" as="geometry"/></mxCell><mxCell id="pool2l" value="AGGREGATE POOL  wdf.dev/pool=aggregate" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="567" y="508" width="336" height="18" as="geometry"/></mxCell><mxCell id="pod2" value="Slot worker pods&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;native, one slot per pod; pandas over the XML result blocks; pod limits cap memory&lt;/font&gt;" style="rounded=1;arcSize=16;