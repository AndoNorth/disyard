<mxfile host="app.diagrams.net"><diagram id="Placement and workers" name="Placement and workers"><mxGraphModel dx="960" dy="890" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="890" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Placement and workers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="920" height="32" as="geometry"/></mxCell><mxCell id="tmp" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="250" height="550" as="geometry"/></mxCell><mxCell id="tmpl" value="TEMPORAL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="78" width="226" height="18" as="geometry"/></mxCell><mxCell id="wf" value="Workflow worker&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;dependencies, retries, timeouts; place is a local activity whose answer stays in history&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="220" height="80" as="geometry"/></mxCell><mxCell id="bl" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="286" width="220" height="320" as="geometry"/></mxCell><mxCell id="bll" value="TASK BACKLOG" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="57" y="294" width="196" height="18" as="geometry"/></mxCell><mxCell id="tq0" value="compile task queue&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;backlog, unversioned&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="60" y="326" width="190" height="52" as="geometry"/></mxCell><mxCell id="tq1" value="simulate task queue&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;backlog, unversioned&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="60" y="426" width="190" height="52" as="geometry"/></mxCell><mxCell id="tq2" value="aggregate task queue&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;backlog, unversioned&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="190" height="52" as="geometry"/></mxCell><mxCell id="ctl" value="" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="330" height="212" as="geometry"/></mxCell><mxCell id="ctll" value="WDF-CONTROL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Mono;spacing=0;" vertex="1" parent="1"><mxGeometry x="322" y="78" width="306" height="18" as="geometry"/></mxCell><mxCell id="sch" value="Placement service&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;stateless, one pod: a pool queue, a memory class and the timeouts from the pool table, or unschedulable&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="325" y="100" width="300" height="64" as="geometry"/></mxCell><mxCell id="log" value="Decision log&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;a line per answer: verdict, snapshot age, ready workers&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="325" y="188" width="145" height="80" as="geometry"/></mxCell><mxCell id="sa" value="Service account&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;read only: get, list on nodes and pods&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;spacingLeft=6;spacingRight=6;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="480" y="188" width="145" height="80" as="geometry"/></mxCell><mxCell id="tbl" value="Pool table&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:10px&quot;&gt;pools.yaml: the slot and the timeouts of each pool&lt;/font&gt;" style="