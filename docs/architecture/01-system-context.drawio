<mxfile host="app.diagrams.net"><diagram id="d1" name="System context"><mxGraphModel dx="1020" dy="1150" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="1150" background="#0a1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Disyard system context" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#c9cbd0;fontSize=20;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="980" height="32" as="geometry"/></mxCell><mxCell id="tagline" value="A dispatch scrapyard: a load is tipped in at intake, sorted by admission and placement, and processed in order by the worker pools." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="980" height="18" as="geometry"/></mxCell><mxCell id="cli" value="Load CLI&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;dispatch, control&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="100" height="60" as="geometry"/></mxCell><mxCell id="api" value="Dispatch API&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;batch submit, control&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#16243e;strokeColor=#0ca5e9;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="160" y="140" width="130" height="60" as="geometry"/></mxCell><mxCell id="intake" value="Intake queues&lt;br&gt;&lt;font color=&quot;#8c8