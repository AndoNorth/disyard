ow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2992;entryDx=0;entryDy=0;" edge="1" parent="1" source="tempo" target="graf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o-pyro-graf" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5118;entryDx=0;entryDy=0;" edge="1" parent="1" source="pyro" target="graf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o-prom-graf" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8465;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="graf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o-ksm-prom" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1196;entryDx=0;entryDy=0;" edge="1" parent="1" source="ksm" target="prom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o-inputs-prom" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8696;entryDx=0;entryDy=0;" edge="1" parent="1" source="inputs" target="prom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o-smoke-prom" value="OTLP push of each row" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="smoke" target="prom"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="982"/></Array></mxGeometry></mxCell><mxCell id="o-smoke-graf" value="annotation" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="smoke" target="graf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="982"/></Array></mxGeometry></mxCell><mxCell id="o-db-inputs" value="" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#8c8f98;strokeWidth=1.6;fontColor=#c9cbd0;fontSize=10;fontFamily=IBM Plex Sans;labelBackgroundColor=#0a1120;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="inputs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="22" y="560"/><mxPoint x="22" y="932"/></Array></mxGeometry></mxCell><mxCell id="legend-h" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontStyle=1;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1038" width="60" height="18" as="geometry"/></mxCell><mxCell id="lg1s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#0ca5e9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="88" y="1042" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg1t" value="layer 1 admission" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="1038" width="116" height="18" as="geometry"/></mxCell><mxCell id="lg2s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#2fd4bf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="1042" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg2t" value="layer 2 placement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="248" y="1038" width="116" height="18" as="geometry"/></mxCell><mxCell id="lg3l" style="endArrow=none;html=1;strokeColor=#8c8f98;strokeWidth=1.6;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378" y="1047" as="sourcePoint"/><mxPoint x="400" y="1047" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg3t" value="dashed = planned, not built yet" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="406" y="1038" width="190" height="18" as="geometry"/></mxCell><mxCell id="lg4s" value="" style="rounded=1;arcSize=30;html=1;fillColor=none;strokeColor=#f4bf51;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="1042" width="10" height="10" as="geometry"/></mxCell><mxCell id="lg4t" value="observability stack, only with DSY_OBS=on" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="625" y="1038" width="380" height="18" as="geometry"/></mxCell><mxCell id="caption" value="A job is tipped in at the Dispatch API, which writes the accepted job to TimescaleDB, then publishes it to intake; admission claims each job&#x27;s row and releases the job to Temporal as capacity allows, so 100,000 submissions wait in a queue instead of becoming 100,000 live workflows. The workflow workers run each job&#x27;s workflow, ask the placement service to place each task, and the task waits on the chosen pool&#x27;s Temporal task queue, which the pool&#x27;s workers poll directly. Placement never moves messages. The top path is the control plane. Compile and aggregate run as native tasks, simulate runs a wasm guest. Workflow workers commit results to object storage and emit job events to TimescaleDB. Prometheus scrapes every service pod, RabbitMQ, SeaweedFS, Temporal and the kubelet, the services push logs and traces to the collector and profiles to Pyroscope, and Grafana reads all four backends. Diagram 05 draws that flow." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#8c8f98;fontSize=11;fontFamily=IBM Plex Sans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1068" width="980" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>