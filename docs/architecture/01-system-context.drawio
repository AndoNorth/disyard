&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;OTLP receiver&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="270" y="862" width="150" height="92" as="geometry"/></mxCell><mxCell id="ksm" value="kube-state-metrics" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="50" y="862" width="170" height="44" as="geometry"/></mxCell><mxCell id="inputs" value="State exporter&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;reads the app database&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#0c1425;strokeColor=#252b39;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="50" y="910" width="170" height="44" as="geometry"/></mxCell><mxCell id="tui" value="Temporal UI&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;127.0.0.1:18233, the per-job view&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1.5;fontColor=#c9cbd0;fontSize=12;fontFamily=IBM Plex Sans;" vertex="1" parent="1"><mxGeometry x="480" y="852" width="190" height="46" as="geometry"/></mxCell><mxCell id="graf" value="Grafana&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;127.0.0.1:13000&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;dashboards, alerts, Explore&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8c8f98&quot; style=&quot;font-size:11px&quot;&gt;smoke results&lt;/font&gt;" style="rounded=1;arcSize=13;html=1;whiteSpace=wrap;fillColor=#152940;strokeColor=#2fd4bf;strokeWidth=1