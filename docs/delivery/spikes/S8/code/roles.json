{
  "buckets": [
    "dsy-sources",
    "dsy-components",
    "dsy-results",
    "dsy-checkpoints"
  ],
  "roles": {
    "submit": {
      "read": [
        "dsy-sources"
      ],
      "write": [
        "dsy-sources"
      ]
    },
    "compile": {
      "read": [
        "dsy-sources",
        "dsy-components"
      ],
      "write": [
        "dsy-components"
      ]
    },
    "simulate": {
      "read": [
        "dsy-components",
        "dsy-results",
        "dsy-checkpoints"
      ],
      "write": [
        "dsy-results",
        "dsy-checkpoints"
      ]
    },
    "aggregate": {
      "read": [
        "dsy-results"
      ],
      "write": [
        "dsy-results"
      ]
    }
  }
}
