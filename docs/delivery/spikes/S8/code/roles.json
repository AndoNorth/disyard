{
  "buckets": [
    "wft-sources",
    "wft-components",
    "wft-results",
    "wft-checkpoints"
  ],
  "roles": {
    "submit": {
      "read": [
        "wft-sources"
      ],
      "write": [
        "wft-sources"
      ]
    },
    "compile": {
      "read": [
        "wft-sources",
        "wft-components"
      ],
      "write": [
        "wft-components"
      ]
    },
    "simulate": {
      "read": [
        "wft-components",
        "wft-results",
        "wft-checkpoints"
      ],
      "write": [
        "wft-results",
        "wft-checkpoints"
      ]
    },
    "aggregate": {
      "read": [
        "wft-results"
      ],
      "write": [
        "wft-results"
      ]
    }
  }
}
