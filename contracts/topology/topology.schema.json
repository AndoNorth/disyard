{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndoNorth/disyard/contracts/topology/topology.schema.json",
  "title": "contracts/topology/topology.yaml",
  "type": "object",
  "required": ["pool_label", "taint_effect", "pools", "namespaces"],
  "additionalProperties": false,
  "properties": {
    "pool_label": { "type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9-]+$" },
    "taint_effect": { "const": "NoSchedule" },
    "pools": {
      "type": "object",
      "additionalProperties": { "enum": ["infra", "obs", "compile", "simulate", "aggregate"] }
    },
    "namespaces": {
      "type": "object",
      "required": ["dsy-infra", "dsy-control", "dsy-workers", "dsy-obs"],
      "additionalProperties": false,
      "properties": {
        "dsy-infra": { "$ref": "#/$defs/namespace" },
        "dsy-control": { "$ref": "#/$defs/namespace" },
        "dsy-workers": { "$ref": "#/$defs/namespace" },
        "dsy-obs": { "$ref": "#/$defs/namespace" }
      }
    }
  },
  "$defs": {
    "namespace": {
      "type": "object",
      "required": ["group"],
      "additionalProperties": false,
      "properties": { "group": { "enum": ["infra", "control", "workers", "obs"] } }
    }
  }
}
