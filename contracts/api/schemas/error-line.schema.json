{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "description": "Every error answer, and the error of an ErrorLine.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "trace_id"
      ],
      "title": "ErrorBody",
      "type": "object"
    }
  },
  "$id": "urn:wft:schema:api:error-line:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The last line of a call that stopped after it began answering.",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "error"
  ],
  "title": "contracts/api error-line",
  "type": "object"
}
