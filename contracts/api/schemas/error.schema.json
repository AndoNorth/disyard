{
  "$id": "urn:dsy:schema:api:error:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every error answer, and the error of an ErrorLine.",
  "properties": {
    "code": {
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message",
    "trace_id"
  ],
  "title": "contracts/api error",
  "type": "object"
}
