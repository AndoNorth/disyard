# Dispatch module: the dispatch and control API as one Deployment on the infra pool, configured from the environment
# only, with its two listeners on the NodePorts of the host access map. The host-side resource dispatch-logins creates
# the service logins in the app database before the service starts, the Secret dispatch-logins carries their DSNs, the
# Secret dispatch-store the submit identity of the store, and the Secret dispatch-broker the password of the broker
# user dispatch, taken from the broker module's helper.
module = read_yaml("module.yaml")
name = module["name"]
namespace = module["namespace"]
res = module["resources"]
topology = read_yaml("../../contracts/topology/topology.yaml")
pool = {"key": topology["pool_label"], "value": "infra"}
tenancy = read_yaml("../../contracts/tenancy/tenancy.yaml")
ports = {p["name"]: p["node_port"] for p in read_yaml("../host/ports.yaml")["ports"]}

tilt_profile = os.getenv("WFT_TILT_PROFILE", "")
if not tilt_profile:
    fail("WFT_TILT_PROFILE is unset: load this module through the root Tiltfile")
if tilt_profile not in tenancy["tilt_profiles"]:
    fail("no tenancy profile for Tilt profile %r in contracts/tenancy/tenancy.yaml" % tilt_profile)

image = "wft-" + name
custom_build(
    image,
    os.path.abspath("image.sh"),
    deps = ["../../packages", "../../uv.lock", "Dockerfile", "image.sh", "../versions.yaml"],
)

store = str(local([os.path.abspath("../../scripts/storage/store/identities.sh"), "path"], quiet = True)).strip()
watch_file("logins.py")
k8s_yaml(encode_yaml_stream(decode_json(str(local(
    ["uv", "run", "--frozen", "--quiet", "python", os.path.abspath("logins.py"), "render", store],
    quiet = True,
)))))

local_resource(
    name + "-logins",
    cmd = [os.path.abspath("logins.sh"), "apply"],
    resource_deps = ["appdb-migrate"],
    labels = [module["group"]],
)

# The helper generates the password on first use, whichever module loads first, and returns the same one after.
broker_password = str(local(
    ["uv", "run", "--frozen", "--quiet", "python", os.path.abspath("../rabbitmq/config.py"), "password", name],
    quiet = True,
    echo_off = True,
)).strip()
k8s_yaml(encode_yaml({
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {"name": name + "-broker", "namespace": namespace},
    "type": "Opaque",
    "stringData": {"WFT_BROKER_PASSWORD": broker_password},
}))

svc = lambda service, port: "%s.wft-infra.svc.cluster.local:%d" % (service, port)
credentials = "/etc/wft/store/credentials.json"
labels = {"app.kubernetes.io/name": name}
# Each listener at the container port the service binds by default, behind the NodePort of its row in the host map.
listeners = {"dispatch-api": 8081, "control-api": 8080}
env = {
    "WFT_TEMPORAL_ADDRESS": svc("temporal-frontend", 7233),
    "WFT_STORE_ENDPOINT": "http://" + svc("objectstore", 8333),
    "WFT_SUBMIT_CREDENTIALS": credentials,
    "WFT_BROKER_ADDRESS": svc("rabbitmq", 5672),
    "WFT_TENANCY_PROFILE": tenancy["tilt_profiles"][tilt_profile],
    "WFT_METRICS_ADDRESS": "0.0.0.0:9090",
}

k8s_yaml(encode_yaml({
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {"name": name, "namespace": namespace, "labels": labels},
    "spec": {
        # One process runs the reconciler and the control retrier, with no leader election, and a surge pod would run
        # them beside it.
        "replicas": 1,
        "strategy": {"type": "Recreate"},
        "selector": {"matchLabels": labels},
        "template": {
            "metadata": {"labels": labels},
            "spec": {
                "nodeSelector": {pool["key"]: pool["value"]},
                "tolerations": [{
                    "key": pool["key"],
                    "operator": "Equal",
                    "value": pool["value"],
                    "effect": topology["taint_effect"],
                }],
                "automountServiceAccountToken": False,
                # Above the service's own drain of 25 s, so the chunk in flight is committed and answered before a kill.
                "terminationGracePeriodSeconds": 30,
                "securityContext": {"runAsNonRoot": True, "seccompProfile": {"type": "RuntimeDefault"}},
                "containers": [{
                    "name": name,
                    "image": image,
                    "env": [{"name": k, "value": v} for k, v in sorted(env.items())],
                    "envFrom": [{"secretRef": {"name": "%s-%s" % (name, s)}} for s in ["logins", "broker"]],
                    "ports": [{"name": n, "containerPort": p} for n, p in sorted(listeners.items())] + [
                        {"name": "metrics", "containerPort": 9090},
                    ],
                    # Ready while every login connects, the store answers a head and Temporal answers, each of which
                    # may take its own connect timeout of 5 s.
                    "readinessProbe": {
                        "httpGet": {"path": "/readyz", "port": "dispatch-api"},
                        "periodSeconds": 5,
                        "timeoutSeconds": 10,
                    },
                    "resources": res[name],
                    "securityContext": {
                        "allowPrivilegeEscalation": False,
                        "readOnlyRootFilesystem": True,
                        "capabilities": {"drop": ["ALL"]},
                    },
                    "volumeMounts": [
                        {"name": "store", "mountPath": "/etc/wft/store", "readOnly": True},
                        {"name": "tmp", "mountPath": "/tmp"},
                    ],
                }],
                "volumes": [
                    {"name": "store", "secret": {"secretName": name + "-store"}},
                    # On disk, not in memory: two spooled uploads of the 128 MiB index cap fit with room to spare.
                    {"name": "tmp", "emptyDir": {"sizeLimit": "512Mi"}},
                ],
            },
        },
    },
}))

for listener, port in sorted(listeners.items()):
    k8s_yaml(encode_yaml({
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {"name": listener, "namespace": namespace, "labels": labels},
        "spec": {
            "type": "NodePort",
            "selector": labels,
            "ports": [{"name": listener, "port": port, "targetPort": listener, "nodePort": ports[listener]}],
        },
    }))

k8s_resource(
    name,
    objects = ["%s-%s:secret:%s" % (name, s, namespace) for s in ["logins", "store", "broker"]],
    labels = [module["group"]],
    resource_deps = [d.split("/")[1] for d in module.get("depends_on", [])] + [name + "-logins"],
)
