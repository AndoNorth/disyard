# The collector of the observability stack: one pod on the obs pool that receives logs and traces by OTLP from the Python services,
# watches the Kubernetes events of every namespace, and forwards logs to Loki and traces to Tempo.
# config.py renders every object of the module, and the configuration is watched, so a change rolls the pod.
module = read_yaml("module.yaml")
name = module["name"]
namespace = module["namespace"]

for path in ["config.py", "../../versions.yaml", "../../../contracts/topology"]:
    watch_file(path)
k8s_yaml(encode_yaml_stream(decode_json(str(local(
    ["uv", "run", "--frozen", "--quiet", "python", os.path.abspath("config.py"), "render"],
    quiet = True,
)))))

k8s_resource(
    name,
    objects = [
        name + ":serviceaccount:" + namespace,
        "dsy-" + name + ":clusterrole",
        "dsy-" + name + ":clusterrolebinding",
        name + "-config:configmap:" + namespace,
    ],
    labels = [module["group"]],
    resource_deps = [d.split("/")[1] for d in module.get("depends_on", [])],
)
