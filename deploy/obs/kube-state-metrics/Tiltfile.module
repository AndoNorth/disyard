# kube-state-metrics of the observability stack: one pod on the obs pool that turns the state of pods, deployments,
# nodes and volume claims into series, which Prometheus finds through the pod's port named `metrics`.
# config.py renders every object of the module.
module = read_yaml("module.yaml")
name = module["name"]
namespace = module["namespace"]

for path in ["config.py", "../../versions.yaml", "../../../contracts/topology"]:
    watch_file(path)
k8s_yaml(encode_yaml_stream(decode_json(str(local(
    ["uv", "run", "--frozen", "--quiet", "python", os.path.abspath("config.py"), "render"],
    quiet = True,
)))))

k8s_resource(
    name,
    objects = [
        name + ":serviceaccount:" + namespace,
        "wft-" + name + ":clusterrole",
        "wft-" + name + ":clusterrolebinding",
    ],
    labels = [module["group"]],
    resource_deps = [d.split("/")[1] for d in module.get("depends_on", [])],
)
