          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"dsy-workers\", container=~\".+-worker\"})",
          "legendFormat": "{{container}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"dsy-workers\", resource=\"memory\"})",
