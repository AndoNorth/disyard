        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(dsy_event_bytes_bucket[$__range]))",
          "legendFormat": "{{le}}",
          "instant": true,
          "range": false
