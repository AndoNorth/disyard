    },
    {
      "type": "bargauge",
      "title": "Volume use by module",
      "description": "Prometheus, Loki, Tempo, Pyroscope and Grafana each keep one volume.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
