      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"wft-obs\"} / kubelet_volume_stats_capacity_bytes{namespace=\"wft-obs\"})",
