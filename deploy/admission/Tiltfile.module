# Admission module: the admission service as one Deployment on the infra pool, configured from the environment only.
# The host-side resource admission-logins creates the service login in the app database before the service starts,
# the Secret admission-logins carries its DSN, and the Secret admission-broker the password of the broker user
# admission, taken from the broker module's helper.
load("../tilt/obs.star", "obs_env")

module = read_yaml("module.yaml")
name = module["name"]
namespace = module["namespace"]
res = module["resources"]
topology = read_yaml("../../contracts/topology/topology.yaml")
pool = {"key": topology["pool_label"], "value": "infra"}
naming = read_yaml("../../contracts/temporal/naming.yaml")
tenancy = read_yaml("../../contracts/tenancy/tenancy.yaml")

tilt_profile = os.getenv("DSY_TILT_PROFILE", "")
if not tilt_profile:
    fail("DSY_TILT_PROFILE is unset: load this module through the root Tiltfile")
if tilt_profile not in tenancy["tilt_profiles"]:
    fail("no tenancy profile for Tilt profile %r in contracts/tenancy/tenancy.yaml" % tilt_profile)

image = "dsy-" + name
custom_build(
    image,
    os.path.abspath("image.sh"),
    deps = ["../../packages", "../../uv.lock", "Dockerfile", "image.sh", "../versions.yaml"],
)

watch_file("logins.py")
k8s_yaml(encode_yaml_stream(decode_json(str(local(
    ["uv", "run", "--frozen", "--quiet", "python", os.path.abspath("logins.py"), "render"],
    quiet = True,
)))))

local_resource(
    name + "-logins",
    cmd = [os.path.abspath("logins.sh"), "apply"],
    resource_deps = ["appdb-migrate"],
    labels = [module["group"]],
)

# The helper generates the password on first use, whichever module loads first, and returns the same one after.
broker_password = str(local(
    ["uv", "run", "--frozen", "--quiet", "python", os.path.abspath("../rabbitmq/config.py"), "password", name],
    quiet = True,
    echo_off = True,
)).strip()
k8s_yaml(encode_yaml({
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": {"name": name + "-broker", "namespace": namespace},
    "type": "Opaque",
    "stringData": {"DSY_BROKER_PASSWORD": broker_password},
}))

svc = lambda service, port: "%s.dsy-infra.svc.cluster.local:%d" % (service, port)
ready = "/tmp/dsy-ready"
labels = {"app.kubernetes.io/name": name}
# DSY_ADMISSION_GLOBAL_CAP and DSY_POOL_QUEUE_PREFIX stay unset: only a driver run sets them, and removes them after.
env = {
    "DSY_TEMPORAL_ADDRESS": svc("temporal-frontend", 7233),
    "DSY_TEMPORAL_NAMESPACE": naming["namespace"],
    "DSY_BROKER_ADDRESS": svc("rabbitmq", 5672),
    "DSY_TENANCY_PROFILE": tenancy["tilt_profiles"][tilt_profile],
    "DSY_METRICS_ADDRESS": "0.0.0.0:9464",
    "DSY_READY_FILE": ready,
}
env.update(obs_env())

k8s_yaml(encode_yaml({
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {"name": name, "namespace": namespace, "labels": labels},
    "spec": {
        # One process admits, with no leader election, and a surge pod would admit beside it.
        "replicas": 1,
        "strategy": {"type": "Recreate"},
        "selector": {"matchLabels": labels},
        "template": {
            "metadata": {"labels": labels},
            "spec": {
                "nodeSelector": {pool["key"]: pool["value"]},
                "tolerations": [{
                    "key": pool["key"],
                    "operator": "Equal",
                    "value": pool["value"],
                    "effect": topology["taint_effect"],
                }],
                "automountServiceAccountToken": False,
                # Above the service's own drain, so the messages it holds are released before a kill.
                "terminationGracePeriodSeconds": 30,
                "securityContext": {"runAsNonRoot": True, "seccompProfile": {"type": "RuntimeDefault"}},
                "containers": [{
                    "name": name,
                    "image": image,
                    "env": [{"name": k, "value": v} for k, v in sorted(env.items())],
                    "envFrom": [{"secretRef": {"name": "%s-%s" % (name, s)}} for s in ["logins", "broker"]],
                    "ports": [{"name": "metrics", "containerPort": 9464}],
                    # The service writes the file once its cycle runs, and removes it when it starts to drain.
                    "readinessProbe": {"exec": {"command": ["test", "-e", ready]}, "periodSeconds": 5},
                    "resources": res[name],
                    "securityContext": {
                        "allowPrivilegeEscalation": False,
                        "readOnlyRootFilesystem": True,
                        "capabilities": {"drop": ["ALL"]},
                    },
                    "volumeMounts": [{"name": "tmp", "mountPath": "/tmp"}],
                }],
                "volumes": [{"name": "tmp", "emptyDir": {"sizeLimit": "16Mi"}}],
            },
        },
    },
}))

k8s_resource(
    name,
    objects = ["%s-%s:secret:%s" % (name, s, namespace) for s in ["logins", "broker"]],
    labels = [module["group"]],
    resource_deps = [d.split("/")[1] for d in module.get("depends_on", [])] + [name + "-logins"],
)
